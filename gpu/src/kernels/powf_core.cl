#define GS_POW_LG2_TAIL as_double(0x3E6EFA39EF35793Cul)
#define GS_POW_LG2_HI   as_double(0x3FE62E42E0000000ul)
#define GS_POW_WCONST   as_double(0x40571547652B82FEul)
#define GS_POW_LN2_64H  as_double(0x3F862E42F0000000ul)
#define GS_POW_LN2_64L  as_double(0xBDFDF473DE6AF278ul)
#define GS_POW_SPLIT    0xFFFFFFFFF8000000ul

static inline double gs_pow(const double x, const double y)
{
    // ucrt pow returns +0 for a base of zero with a positive exponent. The
    // percent chains can reach pct = 100, hence x = 0, which the generic
    // exponent-bit path below would turn into a tiny non-zero value.
    if (x == 0.0) {
        return 0.0;
    }
    const ulong bx = as_ulong(x);
    const double k = convert_double_rte((double)((long)(bx >> 52) & 0x7FFL) - 1023.0);
    const double X = as_double((bx & 0x000FFFFFFFFFFFFFul) | 0x3FE0000000000000ul);
    const ulong idxw = (bx & 0x000FF00000000000ul) + ((bx & 0x0000080000000000ul) << 1);
    const uint idx = (uint)(idxw >> 44);
    const double G = as_double(idxw | 0x3FE0000000000000ul);
    const double d = G - X;
    const double s0 = d * as_double(gs_pow_rcp[idx]);
    const double u = d * as_double(gs_pow_rcp_lo[idx]);
    const double sh = s0 + u;
    const double lo_c = (s0 - sh) + u;
    const double s2 = sh * sh;
    double q = as_double(0x3FC2492492492494ul);
    q = fma(sh, q, as_double(0x3FC5555555555555ul));
    q = fma(sh, q, as_double(0x3FC999999999999Aul));
    q = fma(sh, q, 0.25);
    q = fma(sh, q, as_double(0x3FD5555555555555ul));
    q = fma(sh, q, 0.5);
    const double corr = fma(s2, q, lo_c);
    const double mt = fma(k, GS_POW_LG2_TAIL, -corr);
    const double mlo = mt + as_double(gs_pow_ln_lo[idx]);
    const double ll = mlo - sh;
    const double hi0 = fma(k, GS_POW_LG2_HI, as_double(gs_pow_ln_hi[idx]));
    const double ln_hi = hi0 + ll;
    const double lnm = as_double(as_ulong(ln_hi) & GS_POW_SPLIT);
    const double b = (hi0 - ln_hi) + ll;
    const double c = mlo - (sh + ll);
    const double ln_lo = b + c + (ln_hi - lnm);
    const double y_hi = as_double(as_ulong(y) & GS_POW_SPLIT);
    const double y_lo = y - y_hi;
    const double p1 = y_lo * ln_lo;
    const double p2 = y_lo * lnm;
    const double p3 = ln_lo * y_hi;
    const double p4 = lnm * y_hi;
    const double qq = (p1 + p2) + p3;
    const double z_hi = p4 + qq;
    const double z_lo = (p4 - z_hi) + qq;
    const double w = z_hi * GS_POW_WCONST;
    const double wr = rint(w);
    const long n = convert_long_rte(wr);
    const uint idx2 = (uint)(n & 0x3F);
    const long kk = (n - (long)idx2) >> 6;
    const double a = fma(wr, -GS_POW_LN2_64H, z_hi);
    const double P = (a + wr * GS_POW_LN2_64L) + z_lo;
    double r = as_double(0x3F56C16C16C16C17ul);
    r = fma(P, r, as_double(0x3F81111111111111ul));
    r = fma(P, r, as_double(0x3FA5555555555555ul));
    r = fma(P, r, as_double(0x3FC5555555555555ul));
    r = fma(P, r, 0.5);
    r = fma(P, r, 1.0);
    const double E = P * r;
    const double lo = E * as_double(gs_pow_exp_lo[idx2]) + as_double(gs_pow_exp_lo[idx2]);
    const double hh = (E * as_double(gs_pow_exp_hi[idx2]) + lo) + as_double(gs_pow_exp_hi[idx2]);
    return hh * as_double((ulong)(kk + 1023) << 52);
}


/* Wave-8 f32 powf port: the ucrtbase powf FMA-variant body (export powf,
   dispatch target +0x34D66). Unlike the f64 pow above this is a float-tuned
   pipeline: a single-rounded ln (1/G + ln tables with a cubic series), a
   single-rounded z, a short exp polynomial, a 64-entry 2^(k/64) table, an
   exponent-bit add, then one f64 to f32 rounding. That is why powf is not
   the f32 rounding of pow: the intermediate precision differs. Transcribed
   instruction for instruction, pair-for-pair verified against Rust
   f32::powf in gpu/tests/wave8_powf_gate.rs.
   Scope: x normal >= 1.0625, y normal in (0, 1), result inside f32 range. */



