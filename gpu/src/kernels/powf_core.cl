#define GS_POWF_LN2     as_double(0x3FE62E42FEFA39EFul)
#define GS_POWF_LN2_64H as_double(0x3F862E42FEFA39EFul)

static inline float gs_powf(const float x, const float y)
{
    const double xd = convert_double_rte(x);
    const double yd = convert_double_rte(y);
    const ulong bx = as_ulong(xd);
    const ulong mant = bx & 0x000FFFFFFFFFFFFFul;
    const double k = convert_double_rte((double)((long)(bx >> 52) & 0x7FFL) - 1023.0);
    const uint idx = (uint)((mant >> 44) + ((mant >> 43) & 1ul));
    const double G = as_double((ulong)(idx | 0x3FE00u) << 44);
    const double X = as_double(mant | 0x3FE0000000000000ul);
    const double s = (G - X) * as_double(gs_powf_rinv[idx]);
    double q = fma(s, as_double(0x3FD5555555555555ul), 0.5);
    q = fma(s, q, 1.0);
    const double ln_x = (k * GS_POWF_LN2 + as_double(gs_powf_ln[idx])) - s * q;
    const double z = yd * ln_x;
    const double wr = rint(z * GS_POW_WCONST);
    const long n = convert_long_rte(wr);
    const uint idx2 = (uint)(n & 0x3F);
    const long kk = n >> 6;
    const double a = fma(wr, -GS_POWF_LN2_64H, z);
    double r = fma(a, as_double(0x3FC5555555555555ul), 0.5);
    r = fma(a, r, 1.0);
    const double T = as_double(gs_powf_exp2[idx2]);
    const double res = fma(T, a * r, T);
    return convert_float_rte(as_double(as_ulong(res) + ((ulong)kk << 52)));
}
